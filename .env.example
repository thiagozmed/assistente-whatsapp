# Claude API
ANTHROPIC_API_KEY=
# true = simula as respostas da IA com regras simples, sem chamar a API (grátis, útil pra testar o fluxo antes de configurar crédito)
MOCK_CLAUDE=false

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_VERIFY_TOKEN=escolha-uma-string-qualquer-aqui
# Meta App Dashboard -> Configurações -> Básico -> Chave Secreta do Aplicativo.
# Usada para validar o header X-Hub-Signature-256 em todo POST /webhook.
WHATSAPP_APP_SECRET=

# Supabase (Fase 3 — perfil, preferências, contexto persistente)
# Project Settings -> API -> Project URL / service_role key (nunca a anon key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI Whisper (Fase 4 — transcrição de áudio)
OPENAI_API_KEY=
# true = simula a transcrição sem chamar a API (grátis, útil sem crédito configurado)
MOCK_TRANSCRIPTION=true

# Servidor
PORT=3000
NODE_ENV=development
